Network 1 // Safety Circuit
LD E_STOP
ANDN FAULT_LAMP
AND START_PB
ST SYSTEM_ENABLE

Network 2 // Motor Control
LD SYSTEM_ENABLE
AND START_PB
OR MOTOR_RUN
ANDN STOP_PB
ST MOTOR_RUN

Network 3 // Speed Control
LD MOTOR_RUN
AND SPEED_REF
TON T0, 100
ST CURRENT_PV

Network 4 // Batch Counter
LD SENSOR_1
AND MOTOR_RUN
CTU C0, 10
ST BATCH_COUNT

Network 5 // Temperature Monitoring
LD TEMP_SENSOR
TON T1, 500
ST ALARM_WORD

Network 6 // Fault Detection
LD TEMP_SENSOR
AND STATUS_FLAGS
OR ERROR_CODE
ST FAULT_LAMP 